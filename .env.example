# Copy the values you need into Railway's Variables tab (or your shell). None are required for local use.

# Port to listen on. Railway sets this itself.
PORT=3000

# Folder for the SQLite database file. On Railway, mount a volume and point this at it (for example /data),
# otherwise all scores are lost on every redeploy.
DATA_DIR=./data

# First admin login. Created at startup if it does not exist yet.
ADMIN_EMAIL=

# Sign-in emails are sent through Resend (https://resend.com). Without these two, sign-in links
# are only written to the server log, and an admin creates links by hand under Admin > Logins.
RESEND_API_KEY=
MAIL_FROM=Battle of Schools <scores@battleofschools.id>

# Address encoded in the TV scoreboard's QR code. Can also be set under Admin > Settings.
PUBLIC_URL=https://scores.battleofschools.id

# Set to "production" on the live site: turns off the local test logins and on-page sign-in links.
NODE_ENV=production
